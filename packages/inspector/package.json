{
  "name": "@rotorsoft/act-inspector",
  "version": "0.0.1",
  "private": true,
  "description": "Act event sourcing observatory — inspect, query, and visualize events in Act stores",
  "type": "module",
  "author": {
    "name": "rotorsoft",
    "email": "rotorsoft@outlook.com"
  },
  "scripts": {
    "dev:server": "tsx watch --env-file=.env src/server/server.ts",
    "dev:client": "vite",
    "dev": "concurrently -n 'server,client' -c 'cyan,yellow' 'pnpm run dev:server' 'pnpm run dev:client'",
    "build": "vite build",
    "test": "vitest run --coverage --config ./vitest.config.ts"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@rotorsoft/act": "workspace:^",
    "@rotorsoft/act-pg": "workspace:^",
    "@rotorsoft/act-sqlite": "workspace:^",
    "@tanstack/react-query": "^5.102.8",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "cors": "^2.8.6",
    "d3-scale": "^4.0.2",
    "d3-time": "^3.1.0",
    "lucide-react": "^1.34.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-time": "^3.0.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
