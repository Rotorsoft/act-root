  "scenarios": [
    {
      "title": "12 + 3 =",
      "stream": "A",
      "summary": "Four keys on calculator A. Each digit is counted on the Board, and the operator records A's result so far on CalculatorA.",
      "initial": {
        "result": 0
      },
      "steps": [
        {
          "from": "actor:user",
          "to": "action:PressKey",
          "say": "The user presses **1** on calculator A."
        },
        {
          "from": "action:PressKey",
          "to": "evt:DigitPressed",
          "say": "A digit becomes **DigitPressed** and appends to the left operand.",
          "data": {
            "digit": "1"
          },
          "patch": {
            "left": "1"
          }
        },
        {
          "from": "evt:DigitPressed",
          "to": "reaction:CountDigits",
          "say": "**CountDigits** reacts to every digit, on the **board** lane."
        },
        {
          "from": "reaction:CountDigits",
          "to": "action:CountDigit",
          "say": "It invokes **CountDigit** on the shared Board stream."
        },
        {
          "from": "action:CountDigit",
          "to": "evt:DigitCounted",
          "say": "The Board counts one more **1**.",
          "stream": "Board",
          "data": {
            "digit": "1"
          }
        },
        {
          "from": "actor:user",
          "to": "action:PressKey",
          "say": "The user presses **2**."
        },
        {
          "from": "action:PressKey",
          "to": "evt:DigitPressed",
          "say": "The left operand is now **12**.",
          "data": {
            "digit": "2"
          },
          "patch": {
            "left": "12"
          }
        },
        {
          "from": "evt:DigitPressed",
          "to": "reaction:CountDigits",
          "say": "Counted again."
        },
        {
          "from": "reaction:CountDigits",
          "to": "action:CountDigit",
          "say": "Same reaction, same Board stream."
        },
        {
          "from": "action:CountDigit",
          "to": "evt:DigitCounted",
          "say": "The Board now has one **1** and one **2**.",
          "stream": "Board",
          "data": {
            "digit": "2"
          }
        },
        {
          "from": "actor:user",
          "to": "action:PressKey",
          "say": "The user presses **+**."
        },
        {
          "from": "action:PressKey",
          "to": "evt:OperatorPressed",
          "say": "**OperatorPressed** sets the pending operator. Nothing to compute yet.",
          "data": {
            "operator": "+"
          },
          "patch": {
            "operator": "+"
          }
        },
        {
          "from": "evt:OperatorPressed",
          "to": "reaction:ProjectResult",
          "say": "**ProjectResult** reacts to every operator, on the **result** lane."
        },
        {
          "from": "reaction:ProjectResult",
          "to": "action:ProjectResult",
          "say": "It loads calculator A and records its result."
        },
        {
          "from": "action:ProjectResult",
          "to": "evt:ResultProjected",
          "say": "CalculatorA holds **0**: the sum is computed on the next operator or =.",
          "stream": "CalculatorA",
          "data": {
            "result": 0
          }
        },
        {
          "from": "actor:user",
          "to": "action:PressKey",
          "say": "The user presses **3**."
        },
        {
          "from": "action:PressKey",
          "to": "evt:DigitPressed",
          "say": "With an operator pending, digits go to the right operand.",
          "data": {
            "digit": "3"
          },
          "patch": {
            "right": "3"
          }
        },
        {
          "from": "evt:DigitPressed",
          "to": "reaction:CountDigits",
          "say": "Counted."
        },
        {
          "from": "reaction:CountDigits",
          "to": "action:CountDigit",
          "say": "One more Board update."
        },
        {
          "from": "action:CountDigit",
          "to": "evt:DigitCounted",
          "say": "The Board has counted three digits.",
          "stream": "Board",
          "data": {
            "digit": "3"
          }
        },
        {
          "from": "actor:user",
          "to": "action:PressKey",
          "say": "The user presses **=**."
        },
        {
          "from": "action:PressKey",
          "to": "evt:EqualsPressed",
          "say": "**EqualsPressed** computes 12 + 3. The result becomes the next left operand.",
          "data": {},
          "patch": {
            "result": 15,
            "left": "15",
            "operator": null,
            "right": null
          }
        }
      ]
    },
