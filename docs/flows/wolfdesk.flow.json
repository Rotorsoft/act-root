  "scenarios": [
    {
      "title": "Open to resolved",
      "stream": "ticket-4821",
      "summary": "A customer opens a ticket, the system assigns an agent, they trade messages both ways and the agent resolves it.",
      "steps": [
        {
          "from": "actor:customer",
          "to": "action:OpenTicket",
          "say": "**Carla**, a customer, opens a ticket: Printer on fire, priority High."
        },
        {
          "from": "action:OpenTicket",
          "to": "evt:TicketOpened",
          "say": "The Ticket state is empty, so OpenTicket passes. **TicketOpened** commits at version 0 and carries her first message.",
          "data": {
            "title": "Printer on fire",
            "priority": "High"
          },
          "patch": {
            "title": "Printer on fire",
            "priority": "High",
            "userId": "carla",
            "messages": {
              "m1": {
                "from": "carla",
                "body": "…"
              }
            }
          }
        },
        {
          "from": "evt:TicketOpened",
          "to": "reaction:assign",
          "say": "After the commit, the **assign** reaction picks the event up from the stream."
        },
        {
          "from": "reaction:assign",
          "to": "action:AssignTicket",
          "say": "It picks an agent and invokes **AssignTicket** as the automation actor, with the event as `reactingTo`."
        },
        {
          "from": "action:AssignTicket",
          "to": "evt:TicketAssigned",
          "say": "**TicketAssigned** sets the agent and the deadlines `escalateAfter` and `reassignAfter`.",
          "data": {
            "agentId": "ada",
            "escalateAfter": "Tue 09:00",
            "reassignAfter": "Tue 13:00"
          },
          "patch": {
            "agentId": "ada",
            "escalateAfter": "Tue 09:00",
            "reassignAfter": "Tue 13:00"
          }
        },
        {
          "from": "actor:agent",
          "to": "action:AddMessage",
          "say": "**Ada**, the agent, writes to Carla."
        },
        {
          "from": "action:AddMessage",
          "to": "evt:MessageAdded",
          "say": "Two invariants pass: the ticket is open and Ada is the assigned agent. **MessageAdded** commits.",
          "data": {
            "to": "carla",
            "body": "Unplug it and step away."
          },
          "patch": {
            "messages": {
              "m2": {
                "from": "ada",
                "to": "carla",
                "body": "Unplug it…"
              }
            }
          }
        },
        {
          "from": "evt:MessageAdded",
          "to": "reaction:deliver",
          "say": "The **deliver** reaction claims the stream."
        },
        {
          "from": "reaction:deliver",
          "to": "ext:notify",
          "say": "It hands the message to the **notification service**."
        },
        {
          "from": "reaction:deliver",
          "to": "action:MarkMessageDelivered",
          "say": "Delivery worked, so it invokes **MarkMessageDelivered**."
        },
        {
          "from": "action:MarkMessageDelivered",
          "to": "evt:MessageDelivered",
          "say": "**MessageDelivered** commits.",
          "data": {
            "messageId": "m2"
          },
          "patch": {
            "messages": {
              "m2": {
                "wasDelivered": true
              }
            }
          }
        },
        {
          "from": "actor:customer",
          "to": "action:AcknowledgeMessage",
          "say": "**Carla** reads Ada's reply. Only the receiver may acknowledge a message."
        },
        {
          "from": "action:AcknowledgeMessage",
          "to": "evt:MessageRead",
          "say": "**MessageRead** commits.",
          "data": {
            "messageId": "m2"
          },
          "patch": {
            "messages": {
              "m2": {
                "wasRead": true
              }
            }
          }
        },
        {
          "from": "actor:customer",
          "to": "action:AddMessage",
          "say": "**Carla** answers: it worked."
        },
        {
          "from": "action:AddMessage",
          "to": "evt:MessageAdded",
          "say": "**MessageAdded** commits, addressed to Ada.",
          "data": {
            "to": "ada",
            "body": "Fire is out, thanks."
          },
          "patch": {
            "messages": {
              "m3": {
                "from": "carla",
                "to": "ada",
                "body": "Fire is out…"
              }
            }
          }
        },
        {
          "from": "evt:MessageAdded",
          "to": "reaction:deliver",
          "say": "**deliver** reacts again, for the new message."
        },
        {
          "from": "reaction:deliver",
          "to": "ext:notify",
          "say": "The notification service sends it to Ada."
        },
        {
          "from": "reaction:deliver",
          "to": "action:MarkMessageDelivered",
          "say": "It invokes **MarkMessageDelivered**."
        },
        {
          "from": "action:MarkMessageDelivered",
          "to": "evt:MessageDelivered",
          "say": "**MessageDelivered** commits.",
          "data": {
            "messageId": "m3"
          },
          "patch": {
            "messages": {
              "m3": {
                "wasDelivered": true
              }
            }
          }
        },
        {
          "from": "actor:agent",
          "to": "action:AcknowledgeMessage",
          "say": "**Ada** reads Carla's message."
        },
        {
          "from": "action:AcknowledgeMessage",
          "to": "evt:MessageRead",
          "say": "**MessageRead** commits. An agent has now read a customer message, which is the condition that stops any reassignment.",
          "data": {
            "messageId": "m3"
          },
          "patch": {
            "messages": {
              "m3": {
                "wasRead": true
              }
            }
          }
        },
        {
          "from": "actor:agent",
          "to": "action:MarkTicketResolved",
          "say": "**Ada** marks the ticket resolved."
        },
        {
          "from": "action:MarkTicketResolved",
          "to": "evt:TicketResolved",
          "say": "**TicketResolved** commits and the tickets projection row shows the ticket resolved.",
          "data": {
            "resolvedById": "ada"
          },
          "patch": {
            "resolvedById": "ada"
          }
        }
      ]
    },
    {
      "title": "Escalation chain",
      "stream": "ticket-4822",
      "initial": {
        "title": "Refund not received",
        "priority": "Medium",
        "userId": "carla",
        "messages": {
          "m1": {
            "from": "carla",
            "body": "…"
          },
          "m4": {
            "from": "carla",
            "to": "ada",
            "body": "Any news?",
            "wasDelivered": true
          }
        },
        "agentId": "ada",
        "escalateAfter": "Mon 09:00 (passed)",
        "reassignAfter": "Tue 13:00"
      },
      "summary": "The ticket is assigned and past its escalation deadline. The customer asks for escalation, the system pages the outside world and keeps reassigning until an agent reads her message.",
      "steps": [
        {
          "from": "actor:customer",
          "to": "action:RequestTicketEscalation",
          "say": "**Carla** asks for escalation. Only the owner may, the ticket must be open and `escalateAfter` must have passed."
        },
        {
          "from": "action:RequestTicketEscalation",
          "to": "evt:TicketEscalationRequested",
          "say": "All checks pass. **TicketEscalationRequested** commits.",
          "data": {
            "requestId": "req-31"
          }
        },
        {
          "from": "evt:TicketEscalationRequested",
          "to": "reaction:escalate",
          "say": "The **escalate** reaction picks it up."
        },
        {
          "from": "reaction:escalate",
          "to": "action:EscalateTicket",
          "say": "It invokes **EscalateTicket** with the request data."
        },
        {
          "from": "action:EscalateTicket",
          "to": "evt:TicketEscalated",
          "say": "Not escalated before, so **TicketEscalated** commits. Two reactions listen to it.",
          "data": {
            "escalationId": "esc-77"
