      "id": "reaction:autoClose",
      "lane": "reaction",
      "label": "autoClose",
      "col": 1,
      "file": "packages/wolfdesk/src/ticket-timers.ts",
      "description": "Throws a DeferSignal until the ticket's closeAfter, then closes the ticket if nobody closed it first. Runs on its own target close:<ticket>.",
      "badge": "⏱",
      "as": "ticket-timers"
    },
    {
      "id": "reaction:autoEscalate",
      "lane": "reaction",
      "label": "autoEscalate",
      "col": 2,
      "file": "packages/wolfdesk/src/ticket-timers.ts",
      "description": "`.defer`red to escalateAfter on TicketAssigned. Escalates if the ticket is still open and not escalated. Target escalate:<ticket>.",
      "badge": "⏱",
      "as": "ticket-timers"
    },
    {
      "id": "reaction:deliver",
      "lane": "reaction",
      "label": "deliver",
      "col": 3,
      "file": "packages/wolfdesk/src/ticket-messaging.ts",
      "description": "Sends the message through the notification service, then marks it delivered. Up to 5 retries with exponential backoff and jitter.",
      "as": "deliver reaction"
    },
    {
      "id": "reaction:escalate",
      "lane": "reaction",
      "label": "escalate",
      "col": 6,
      "file": "packages/wolfdesk/src/ticket-operations.ts",
      "description": "Turns an escalation request into EscalateTicket.",
      "as": "escalate reaction"
    },
    {
      "id": "reaction:autoReassign",
      "lane": "reaction",
      "label": "autoReassign",
      "col": 7,
      "file": "packages/wolfdesk/src/ticket-timers.ts",
      "description": "Defers to reassignAfter, then reassigns the ticket unless an agent has read one of the customer's messages or the ticket is closed. Target reassign:<ticket>.",
      "badge": "⏱",
      "as": "ticket-timers"
    },
    {
      "id": "reaction:webhook",
      "lane": "reaction",
      "label": "escalation webhook",
      "col": 8,
      "file": "packages/wolfdesk/src/ticket-webhooks.ts",
      "description": "webhook() from @rotorsoft/act-http on its own webhooks lane: 30 s lease, 2 s timeout, 3 retries with exponential backoff, Idempotency-Key, optional HMAC signing. All tickets share one target, ticket-escalation-webhooks.",
      "as": "webhooks lane"
    },
    {
      "id": "reaction:autoReassignAgain",
      "lane": "reaction",
      "label": "autoReassignAgain",
      "col": 9,
      "file": "packages/wolfdesk/src/ticket-timers.ts",
      "description": "Each TicketReassigned pushes reassignAfter forward and re-arms the same check. The chain stops once an agent reads a customer message.",
      "badge": "⏱",
      "as": "ticket-timers"
    },
    {
      "id": "ext:notify",
      "lane": "external",
      "label": "Notification service",
      "col": 3,
      "file": "packages/wolfdesk/src/services/notification.ts",
      "description": "deliverMessage(): the outbound channel. In development it fails the first WOLFDESK_DELIVERY_FAILS attempts per message so the backoff shows."
    },
    {
      "id": "ext:hook",
      "lane": "external",
      "label": "Incident endpoint",
      "col": 8,
      "file": "packages/server/src/webhook-receiver.ts",
      "description": "WOLFDESK_ESCALATION_WEBHOOK. The demo receiver verifies the signature and dedupes on the Idempotency-Key, so retries are safe."
    }
