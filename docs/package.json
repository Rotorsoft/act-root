{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:all": "node scripts/flows.mjs build && typedoc --options typedoc.json && docusaurus build",
    "flows": "node scripts/flows.mjs build",
    "flows:video": "node scripts/flows.mjs video",
    "snippets:extract": "node scripts/check-snippets.mjs",
    "check:snippets": "node scripts/check-snippets.mjs --check",
    "check:snippets:selftest": "node scripts/check-snippets.mjs --self-test",
    "clear": "docusaurus clear",
    "swizzle": "docusaurus swizzle",
    "serve": "docusaurus serve"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@stackblitz/sdk": "^1.11.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@rotorsoft/act": "workspace:^",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "docusaurus-plugin-typedoc": "^1.4.3",
    "playwright-core": "^1.64.1",
    "typedoc": "~0.28.20",
    "typedoc-plugin-markdown": "~4.14.0",
    "typescript": "~6.0.3",
    "zod": "^4.6.7"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=22.23.3"
  }
}
