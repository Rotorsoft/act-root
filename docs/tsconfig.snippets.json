{
  // Type-checks tangled doc snippets (docs/.snippets/, written by
  // scripts/check-snippets.mjs) against the live @rotorsoft/act source.
  // Paths come from the workspace config, so snippets resolve the same
  // module graph as the rest of the repo.
  "extends": "../tsconfig.workspace.json",
  "compilerOptions": { "noEmit": true },
  "include": [".snippets/**/*.ts"]
}
