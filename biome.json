{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.ts",
      "**/*.json",
      "**/biome.json",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!**/build",
      "!**/.docusaurus",
      "!**/*.d.ts",
      "!docs/docs/api",
      "!docs/api",
      "!docs/static",
      "!docs/build",
      "!**/.postgres",
      "!**/drizzle/meta",
      "!.vscode",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5",
      "bracketSpacing": true,
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noBannedTypes": "off",
        "noUselessLoneBlockStatements": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noUnsafeDeclarationMerging": "off",
        "noAssignInExpressions": "off",
        "noConfusingVoidType": "off",
        "noConsole": "error"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "useImportType": "error",
        "noParameterAssign": "error"
      },
      "correctness": {
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        }
      },
      "performance": {
        "noAccumulatingSpread": "warn"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/__tests__/**",
        "**/test/**",
        "**/scripts/**",
        "**/*.bench.ts",
        "packages/**",
        "performance/**",
        "recipes/**",
        "docs/src/snippets/**",
        "libs/act-diagram/src/server/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": ["docs/src/snippets/**"],
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    }
  ]
}
