import type { ActBuilder } from "../types/builders.js";
import type { Actor, Schema, SchemaRegister, Schemas } from "../types/index.js";
/**
 * Creates a new Act orchestrator builder for composing event-sourced applications.
 *
 * @example Basic application with single state
 * \`\`\`typescript
 * const app = act()
 *   .withState(Counter)
 *   .build();
 * \`\`\`
