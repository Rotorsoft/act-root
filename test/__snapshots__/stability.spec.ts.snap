import type { BroadcastState, PatchMessage } from "./types.js";
/**
 * Result of applying a patch message to cached client state.
 */
export type ApplyResult<S extends BroadcastState = BroadcastState> = {
    ok: true;
    state: S;
} | {
    ok: false;
    reason: "stale" | "behind";
