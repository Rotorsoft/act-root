    category: "reaction-health";
    stream: string;
    status: "blocked" | "near-block" | "stuck-backoff";
    retry: number;
    reason: string;
} | {
    category: "snapshot-drift";
    stream: string;
    events_since_snap: number;
    snap_at?: number;
} | {
    category: "routing-health";
    stream: string;
    reason: "unknown-lane" | "unrouted";
