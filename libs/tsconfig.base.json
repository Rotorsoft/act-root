{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@rotorsoft/act/adapter": ["./act/src/adapter.ts"],
      "@rotorsoft/act/test": ["./act/src/test/index.ts"],
      "@rotorsoft/act/types": ["./act/src/types/index.ts"],
      "@rotorsoft/*": ["./*/src/index.ts"]
    }
  }
}
